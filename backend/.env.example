# Copy this file to .env (same folder) and fill in a key. .env is ignored by git; this file is not, so keep keys out of it.
# Which model reads invoices: gemini or claude. If left empty, whichever key is present is used (Gemini first).
MODEL_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model, e.g. gemini-2.5-flash. If empty, the newest stable Flash model is picked.
GEMINI_MODEL=

# For later, once the Claude API is bought: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
